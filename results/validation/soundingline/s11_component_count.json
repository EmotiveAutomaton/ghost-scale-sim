    "n_features": 1024,
    "n_nuisance": 5,
    "repeats": 3,
    "k_sweep": [
      3,
      7,
      12,
      20,
      30
    ],
    "n_sweep": [
      150,
      300,
      600,
      1200,
      2400
    ],
    "nuisance_ratios": [
      0.0,
      0.25,
      0.5,
      1.0,
      2.0,
      4.0
    ],
    "target": "total planted rank = K + nuisance, because no unsupervised eigenvalue criterion can distinguish a drive factor from a topic factor. The drives_only arm asks the pure question with nuisance switched off."
  },
