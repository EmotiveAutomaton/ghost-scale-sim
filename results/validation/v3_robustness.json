{
  "check": "V-3",
  "question": "Are the headline results knife-edge or robust?",
  "framing": "A scoping exercise, not a pass/fail. A result that holds across the whole range and a result that holds in a narrow window are both real; they are different claims, and the point of this matrix is to make the README able to say which is which.",
  "plain_language": "Every setting in the model was chosen by somebody. This check moves each one to a low and a high value in turn and asks whether the finding is still there. A finding that only appears at one setting is a much smaller claim than a finding that survives the whole range, and both get described accurately.",
  "scale": {
    "n_observers": 60,
    "n_seeds": 16,
    "note": "the readability-axis headline runs at half the seeds; see HEADLINES"
  },
  "criteria": {
    "weaken_fraction": 0.5,
    "tuned_window_fraction": 0.4
  },
  "sweeps": [
    {
      "parameter": "effort_cost",
      "plain_language": "how much it costs the reader to look closely",
      "levels": [
        "low",
        "default",
        "high"
      ],
      "why_this_range": "the low and high ends are the ends of E3's own committed sweep, so the range is the one the project already explored rather than one chosen here",
      "headlines": [
        "label_effect",
        "interior_peak"
      ]
    },
    {
      "parameter": "label_precision",
      "plain_language": "how much the reader trusts the label",
      "levels": [
        "low",
        "default",
        "high"
      ],
      "why_this_range": "E4 swept kappa from 0 to 0.99 and located a threshold near 0.20; the low end sits above that threshold deliberately, so this measures robustness inside the regime the claim is made in rather than the already-published collapse below it",
      "headlines": [
        "label_effect",
        "interior_peak"
      ]
    },
    {
      "parameter": "planning_horizon",
      "plain_language": "how far ahead the reader plans",
      "levels": [
        "myopic",
        "default",
        "longer"
      ],
      "why_this_range": "policy_len = 1 collapses the attention dynamics by the config's own note, so it is included precisely because it is the adversarial end",
      "headlines": [
        "label_effect",
        "interior_peak"
      ]
    },
    {
      "parameter": "prior_strength",
      "plain_language": "how strong the reader's starting hunch is",
      "levels": [
        "weak",
        "default",
        "strong"
      ],
      "why_this_range": "reader heterogeneity is what the between-reader measure is made of, so this is the parameter most likely to move a disagreement number",
      "headlines": [
        "label_effect",
        "interior_peak"
      ]
    },
    {
      "parameter": "separation_floor",
      "plain_language": "how distinguishable the maker's possible purposes are",
      "levels": [
        "shallow",
        "default",
        "sharp"
      ],
      "why_this_range": "the peak mass is what the pairwise Jensen-Shannon floor is asserted against; 0.60 is close to where that assertion starts to bind",
      "headlines": [
        "label_effect",
        "interior_peak"
      ]
    },
    {
      "parameter": "opacity_ramp",
      "plain_language": "the Ghost Scale opacity values read as recoverable intent",
      "levels": [
        "compressed",
        "default",
        "stretched"
      ],
      "why_this_range": "this is the framework's one empirical commitment, so a result that depends on the exact published values rather than on their ordering is a much weaker claim. Compressed pulls all four tiers halfway to their mean; stretched pushes them to the full 0 - 1 range",
      "headlines": [
        "label_effect",
        "interior_peak"
      ]
    },
    {
      "parameter": "observer_count",
      "plain_language": "how many readers are simulated",
      "levels": [
        "half",
        "default",
        "double"
      ],
      "why_this_range": "included because the between-reader measures are the ones whose estimates depend on the number of readers; it is a power check wearing a robustness hat, and V-7 does the same job at a different seed block",
      "headlines": [
        "label_effect"
      ]
    },
    {
      "parameter": "goal_count",
      "plain_language": "how many purposes the reader considers",
      "levels": [
        "two",
        "default",
        "default_again"
      ],
      "why_this_range": "the disagreement ceiling is ln(goals), so this changes the yardstick as well as the measurement, and the verdict has to survive that. Only the downward direction is available: the feature partition tiles eight features into four pairs, so more goals needs more features, which is the next sweep",
      "headlines": [
        "label_effect"
      ]
    },
    {
      "parameter": "feature_count",
      "plain_language": "how much detail the work carries",
      "levels": [
        "eight",
        "default",
        "sixteen"
      ],
      "why_this_range": "the whole V4 reframe needed the feature space doubled to get a disjoint partition, which makes the feature count a parameter with a documented history of mattering",
      "headlines": [
        "label_effect"
      ]
    }
  ],
  "not_swept": {
